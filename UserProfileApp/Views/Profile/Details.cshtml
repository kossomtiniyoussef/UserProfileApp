@model UserProfileApp.Models.User

@{
    ViewData["Title"] = "User Profile";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">User Profile</h3>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-4 text-center">
                            <img src="@(string.IsNullOrEmpty(Model.ProfilePictureUrl) ? "https://via.placeholder.com/150" : Model.ProfilePictureUrl)" 
                                 class="rounded-circle img-fluid shadow-sm" alt="Profile Picture" style="width: 150px; height: 150px; object-fit: cover;" />
                        </div>
                        <div class="col-md-8">
                            <h4>@Model.FirstName @Model.LastName</h4>
                            <p class="text-muted">@@@Model.Username</p>
                            <p><strong>Email:</strong> @Model.Email</p>
                            <p><strong>Bio:</strong> @(string.IsNullOrEmpty(Model.Bio) ? "No bio provided yet." : Model.Bio)</p>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between">
                        <a asp-action="Edit" asp-route-id="@Model.UserId" class="btn btn-warning">Edit Profile</a>
                        <small class="text-muted align-self-center">Last Updated: @Model.UpdatedAt.ToLocalTime()</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>